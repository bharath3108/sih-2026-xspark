{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalEvent",
  "type": "object",
  "required": ["event_id", "source", "author_id_hash", "timestamp_utc", "text"],
  "properties": {
    "event_id": { "type": "string" },
    "source": { "type": "string" },
    "author_id_hash": { "type": "string" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "text": { "type": "string" }
  }
}
